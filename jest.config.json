{
  "moduleFileExtensions": ["js", "json", "ts"],
  "roots": ["<rootDir>/src"],
  "testRegex": ".*\\.spec\\.ts$",
  "extensionsToTreatAsEsm": [".ts"],
  "transform": {
    "^.+\\.ts$": [
      "ts-jest",
      {
        "useESM": true,
        "tsconfig": { "isolatedModules": true, "module": "esnext", "moduleResolution": "bundler" }
      }
    ]
  },
  "moduleNameMapper": {
    "^@/(.*)$": "<rootDir>/src/$1"
  },
  "collectCoverageFrom": [
    "src/**/*.ts",
    "!src/**/*.spec.ts",
    "!src/main.ts",
    "!src/app.module.ts",
    "!src/app.setup.ts",
    "!src/config/**",
    "!src/db/migrations/**",
    "!src/db/seeds/**",
    "!src/db/entities/**",
    "!src/**/*.module.ts",
    "!src/**/*.controller.ts",
    "!src/**/dto/**",
    "!src/**/*.repository.ts",
    "!src/**/*.mapper.ts"
  ],
  "coverageDirectory": "<rootDir>/coverage",
  "testEnvironment": "node"
}
